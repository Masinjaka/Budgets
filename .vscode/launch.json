    "version": "0.2.0",
    "configurations": [
        {
            "name": "Budgets",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=SUPABASE_URL=${env:SUPABASE_URL}",
                "--dart-define=SUPABASE_ANON_KEY=${env:SUPABASE_ANON_KEY}",
                "--dart-define=GLEAP_TOKEN=${env:GLEAP_TOKEN}",
                "--dart-define=SENTRY_DSN=${env:SENTRY_DSN}"
            ]
        },
        {
            "name": "Budgets (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define=SUPABASE_URL=${env:SUPABASE_URL}",
                "--dart-define=SUPABASE_ANON_KEY=${env:SUPABASE_ANON_KEY}",
                "--dart-define=GLEAP_TOKEN=${env:GLEAP_TOKEN}",
                "--dart-define=SENTRY_DSN=${env:SENTRY_DSN}"
            ]
        },
        {
            "name": "Budgets (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define=SUPABASE_URL=${env:SUPABASE_URL}",
                "--dart-define=SUPABASE_ANON_KEY=${env:SUPABASE_ANON_KEY}",
                "--dart-define=GLEAP_TOKEN=${env:GLEAP_TOKEN}",
                "--dart-define=SENTRY_DSN=${env:SENTRY_DSN}"
            ]
        }
    ]
}